# Copy to .env (never commit .env). Every variable is optional.

# AI provider: groq (default) | nvidia_nim | mock. Without a key the app works; AI features say "IA désactivée".
LLM_PROVIDER=groq
LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b            # Groq default; NIM default: meta/llama-3.1-70b-instruct
# LLM_BASE_URL=                            # OpenAI-compatible gateway / proxy
# LLM_TIMEOUT_S=30

# Docker Compose only
# CORS_ORIGINS=http://localhost:3000
# PUBLIC_API_URL=http://localhost:8000     # API URL as seen by the browser (frontend build arg)
