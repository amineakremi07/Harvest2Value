{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["producer", "crop", "buyers", "logistics"],
  "properties": {
    "producer": {
      "type": "object",
      "required": ["id", "name", "region", "country", "harvest_kg", "storage_capacity_kg", "shelf_life_days"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "region": {"type": "string"},
        "country": {"type": "string"},
        "harvest_kg": {"type": "number", "minimum": 0},
        "storage_capacity_kg": {"type": "number", "minimum": 0},
        "storage_cost_per_kg_per_day": {"type": "number"},
        "shelf_life_days": {"type": "integer", "minimum": 1}
      }
    },
    "crop": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string"},
        "type": {"type": "string", "enum": ["perishable", "semi_perishable", "durable"]},
        "unit": {"type": "string"}
      }
    },
    "buyers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "location", "max_demand_kg", "price_per_kg"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "location": {"type": "string"},
          "max_demand_kg": {"type": "number"},
          "price_per_kg": {"type": "number"},
          "distance_km": {"type": "number"},
          "transport_cost_per_kg_per_km": {"type": "number"}
        }
      }
    },
    "logistics": {
      "type": "object",
      "properties": {
        "available_vehicles": {"type": "integer"},
        "vehicle_capacity_kg": {"type": "number"},
        "refrigerated_required": {"type": "boolean"},
        "road_condition": {"type": "string", "enum": ["good", "fair", "poor"]}
      }
    }
  }
}